# ===== Bắt buộc =====
# Địa chỉ công khai của ứng dụng (dùng trong liên kết email), không có dấu / cuối
APP_URL=https://quanly.ten-mien.vn

# ===== Quản trị viên đầu tiên =====
# Chỉ dùng khi CSDL chưa có quản trị viên nào; có thể xóa hai biến này sau khi đăng nhập được.
ADMIN_EMAIL=admin@ten-mien.vn
ADMIN_PASSWORD="doi-mat-khau-nay"
# ADMIN_NAME=

# ===== Email (đặt lại mật khẩu, lời mời, thông báo) — tùy chọn =====
# SMTP bất kỳ: Gmail (mật khẩu ứng dụng), Zoho, Brevo, Resend (smtp.resend.com, user "resend", mật khẩu là API key)…
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=true   # mặc định true nếu cổng 465
SMTP_USER=thongbao@ten-mien.vn
SMTP_PASS="mat-khau-ung-dung"
EMAIL_FROM="Trung tâm điều hành <thongbao@ten-mien.vn>"
# EMAIL_INTERVAL_MIN=10

# ===== Chạy trên máy (npm run dev:api) =====
# DATA_DIR=./.data     # mặc định ./.data khi chạy thường, /data trong Docker
# PORT=3000
# DEMO_PASSWORD=Demo@12345   # mật khẩu tài khoản mẫu của npm run demo:seed
# TRUST_PROXY=1        # số proxy trước ứng dụng (Coolify = 1, thêm Cloudflare = 2)
